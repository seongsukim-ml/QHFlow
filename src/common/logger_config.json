{
    "enable_logger": false,
    "use_rich": false,
    "log_level": "INFO",
    "log_file_path": "./log.log",
    "console_format": "%(levelname)s: %(message)s",
    "file_format": "[%(asctime)s]\\t%(levelname)s\\t[%(filename)s:%(funcName)s:%(lineno)s]\\t>> %(message)s",
    "rich_format": "[%(filename)s:%(lineno)s] >> %(message)s"
}
